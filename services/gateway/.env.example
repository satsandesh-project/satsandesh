# Copy this file to .env and fill in real values for local development.
# .env is gitignored; .env.example is committed as the template.

APP_ENV=dev                                    # dev | staging | prod — informational, not yet branched on anywhere
PORT=8000                                       # port uvicorn listens on
DATABASE_URL=postgresql://user:password@localhost:5432/satsandesh  # not yet used — nothing connects to Postgres today; see app/config.py
JWT_SECRET=change-me-to-a-long-random-value     # not yet used — auth is still stubbed in app/auth.py; see app/config.py
LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=                                   # comma-separated list of allowed origins, e.g. http://localhost:3000,https://app.example.com
