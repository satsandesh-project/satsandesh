# Template for .env — copy this file to .env and fill in real dev values:
#   cp .env.example .env
# .env itself is gitignored and must never be committed.

POSTGRES_USER=satsandesh
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=satsandesh
DATABASE_URL=postgresql://satsandesh:changeme_dev_password@postgres:5432/satsandesh

# Host port Postgres is published on (container-internal port is always
# 5432 -- see DATABASE_URL above, which uses the service name over the
# compose-internal network, not this). Only change this if 5432 is
# already taken on the host, e.g. a shared server running another
# project's own Postgres.
POSTGRES_HOST_PORT=5432

# services/gateway/'s own required settings (app/config.py). A missing
# value here crashes that container at startup with a readable error,
# not silently.
GATEWAY_JWT_SECRET=changeme_generate_a_random_hex_secret
# Generate a real keypair with: vapid --gen  (py-vapid, pinned in
# services/gateway/requirements.txt) -- prints private_key.pem/
# public_key.pem; paste their contents here. See
# services/gateway/README.md's "Configuration" section.
GATEWAY_VAPID_PRIVATE_KEY=changeme_run_vapid_gen
GATEWAY_VAPID_PUBLIC_KEY=changeme_run_vapid_gen
GATEWAY_VAPID_SUBJECT=mailto:dev@example.com

# Comma-separated. Must list the elder client's real origin(s) exactly --
# see services/gateway/app/main.py's CORS setup for why this can't be "*".
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Week 6: media storage (voice-note uploads, services/gateway/app/media.py).
# Max size of a single upload, in bytes. Default (2 MiB, set in
# app/config.py if this is left unset) is generous headroom over a real
# 30-second Opus voice note's actual size (~100KB) -- a 10-minute note
# would still fit. Uncomment and lower this if uploads need a tighter cap
# than the default, e.g. on a more disk-constrained deployment.
# MEDIA_MAX_UPLOAD_BYTES=2097152

# Week 6: durable job queue (services/gateway/app/jobs.py). All have sane
# defaults in app/config.py -- uncomment only to override.
# JOB_POLL_INTERVAL_SECONDS=1.0
# JOB_LEASE_SECONDS=300
# JOB_MAX_ATTEMPTS=5
# Uncomment to disable the in-process worker entirely (jobs still enqueue
# and sit in the table, just never get claimed/run) -- not needed for
# tests, which already default this off via
# services/gateway/tests/conftest.py, independent of this file.
# JOB_WORKER_ENABLED=false

# The single origin the browser reaches everything through. Staging
# overrides this to http://<server-ip> -- see docs/deployment.md.
PUBLIC_ORIGIN=http://localhost

# Host port Caddy is published on. Only change this if 80 is already
# taken on the host (e.g. a shared server's own system-level Apache/
# Nginx). If you do, ALLOWED_ORIGINS and PUBLIC_ORIGIN above must include
# this same port explicitly -- browsers only omit the port from the
# Origin header when it's the protocol's real default (80 for http).
CADDY_HOST_PORT=80
