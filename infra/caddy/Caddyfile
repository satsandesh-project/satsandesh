:80 {
	# Most specific matches first -- a catch-all further down would
	# otherwise swallow everything ahead of it.

	# AI services.
	handle_path /ai/* {
		reverse_proxy ai-services:8001
	}

	# Gateway's own routes -- services/gateway/'s real route set (Week 1
	# correction, 2026-09-01: the skeleton now boots services/gateway/,
	# not gateway/). No /session, no /db-check -- neither exists on this
	# gateway; auth is HTTPBearer (any non-empty token, still a stub) and
	# there's no separate schema-check endpoint. `handle` (not
	# `handle_path`) preserves the path -- the handlers expect the full
	# path (e.g. `/health`), not a stripped one.
	handle /health {
		reverse_proxy gateway:8000
	}
	handle /health/ready {
		reverse_proxy gateway:8000
	}
	handle /me {
		reverse_proxy gateway:8000
	}
	# GET/PATCH /me/settings (Week 7, services/gateway/app/users.py). `/me` above
	# is an EXACT match, so without this a request for /me/settings fell through
	# to the catch-all and got the elder-app's own 404 page instead of the gateway.
	handle /me/settings {
		reverse_proxy gateway:8000
	}
	# GET /audio-labels/{label} (Week 4, app/audio_labels.py). The elder app calls
	# it for every hold-to-hear button and it was never routed here, so on any
	# Caddy deployment those buttons reached the elder-app's 404 page.
	handle /audio-labels/* {
		reverse_proxy gateway:8000
	}
	handle /ws {
		reverse_proxy gateway:8000
	}
	handle /circles* {
		reverse_proxy gateway:8000
	}
	handle /messages* {
		reverse_proxy gateway:8000
	}
	# Week 6: voice-note storage (services/gateway/app/media.py). Missing
	# until now (#64) -- with no explicit handler, a request here fell
	# through every block above straight to the catch-all below, so
	# GET /media/{id} returned the elder-app's own 404 page instead of
	# the gateway's, and a voice note could never actually be played
	# back even though the upload itself worked.
	handle /media* {
		reverse_proxy gateway:8000
	}
	# QR onboarding (Week 8, services/gateway/app/onboarding.py): POST /invite,
	# GET /qr/{token}, POST /activate. Missing until the Week 8 gate walked the
	# "onboarded elder" clause (infra/ai/GATE_WEEK8.md): through Caddy, GET
	# /onboarding/qr/junk was the elder app's own 404 PAGE and POST
	# /onboarding/activate its 405, while the gateway answered the same calls
	# correctly when called directly (invite 201, activate 200, a second activate
	# 410). Same omission as /media* and /audio-labels/* above. ROUTING IS
	# NECESSARY, NOT SUFFICIENT: the elder app has no call to /onboarding yet
	# (only comments saying QR onboarding is not merged), so that half is M1's.
	handle /onboarding* {
		reverse_proxy gateway:8000
	}
	# /push* (POST /push/subscribe, /push/unsubscribe, services/gateway/app/push.py)
	# is deliberately NOT routed. Nothing calls it (the elder app has no service
	# worker or subscribe call), it needs VAPID keys and a client that does not
	# exist, and an unrouted endpoint is one less surface to a request nobody
	# makes. It is the same one-line omission as /onboarding* was: the first
	# client to implement web push adds
	#     handle /push* { reverse_proxy gateway:8000 }
	# here AND the matching check in infra/caddy/tls_check.py (which today asserts
	# it is NOT routed, so that a later change has to be deliberate).
	# The moderator console's routes (services/gateway/app/moderation.py: queue, a message's event
	# trail, release, block). They were deliberately unrouted while the gateway's identity was a
	# stub (OPEN_QUESTIONS #23): any bare UUID was "that user", so a moderator's id alone read the
	# queue and a held message's text (shown on a real stack, AUTH_MODE=legacy). That is closed AT
	# THE GATEWAY, not here: Caddy cannot know the gateway's AUTH_MODE, so every /moderation* route
	# accepts ONLY a signed token (401 for none, a bare UUID or a bad one; 403 for a valid
	# non-moderator, whose role is read from users.role on every request). With that, routing is safe
	# in every mode. Routing is necessary, not sufficient: nothing serves the console itself yet
	# (clients/admin-console/ is in no compose file), so there is still no console to open here.
	handle /moderation* {
		reverse_proxy gateway:8000
	}

	# Everything else -- both the elder-app frontend itself (compiled
	# pages, JS bundles) AND Reflex's own internal backend paths (/ping,
	# /_event*, /_upload*, /_health, /_all_routes -- its state sync, not
	# the SatSandesh gateway). These used to be split across two ports
	# (elder-app:3000 vs :8000) because Reflex's DEV mode runs frontend
	# and backend as separate processes on separate ports. The
	# Dockerfile runs --env prod, which unifies both onto ONE port
	# (confirmed by reading Reflex's own source -- see the Dockerfile's
	# comment) -- so every elder-app path, internal or not, now genuinely
	# goes to the same place, and the split was actively wrong (pointing
	# at a port nothing binds in prod mode) until fixed here.
	handle {
		reverse_proxy elder-app:3000
	}
}

# Local dev / early staging only -- plain HTTP on port 80, proxying by
# Docker Compose's internal service-name DNS. HTTPS via Let's Encrypt
# needs a real domain (see docs/deployment.md) and is deliberately
# deferred until before Week 6-7, when microphone access starts requiring
# it (browsers block getUserMedia on non-HTTPS origins except localhost).
