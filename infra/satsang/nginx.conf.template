# Rendered by entrypoint.sh (it fills in the @...@ values); never mounted as it is.
include /etc/nginx/modules-enabled/*.conf;
worker_processes 1;
# `warn`, not `info`: at info, nginx-rtmp logs the publish URL with its arguments, i.e. the key.
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 256; }

rtmp {
    server {
        listen 1935;
        # The speaker publishes to rtmp://host:1935/live/<session id>?key=<key>. The stream NAME
        # is the session id, never the key: HLS files are named after the stream name, and those
        # names are in every listener's URL (measured; see services/gateway/app/satsang.py).
        application live {
            live on;
            record off;
            deny play all;          # the only way to hear it is the HLS below
            notify_method post;
            # Both go through the local proxy below, which adds the shared secret and finds the
            # gateway by name at request time. Nothing secret sits in these two lines.
            on_publish http://127.0.0.1:8081/publish;
            on_publish_done http://127.0.0.1:8081/done;
            hls on;
            hls_path /var/hls;
            hls_cleanup on;
            # THE latency/robustness tradeoff. A player starts about three fragments behind the
            # live edge, so the delay is roughly 3 x fragment + encode + buffering: with 4 s,
            # 12-15 s. The proposal accepts 10-20 s for a discourse. A 1-second fragment would cut
            # that to ~4 s but make a phone on 3G fetch one segment per second, each with its own
            # round trip, and one slow response stalls the player: it would not survive 3G.
            # 4 s keeps the request rate low and gives a segment room to arrive late. The 32 s
            # playlist is 8 fragments: a listener who stalls up to ~20 s can still catch up.
            hls_fragment @HLS_FRAGMENT@;
            hls_playlist_length @HLS_PLAYLIST@;
        }
    }
}

http {
    access_log off;

    # Only nginx-rtmp calls this (it listens on loopback inside the container). It forwards the
    # two hooks to the gateway and adds the shared secret, so the secret lives in this rendered
    # file and the gateway's environment only. The gateway is looked up again at each request
    # (resolver + variable), so recreating the gateway container does not leave nginx pointing
    # at a dead address.
    server {
        listen 127.0.0.1:8081;
        resolver 127.0.0.11 valid=5s ipv6=off;
        set $gateway http://gateway:8000;
        location = /publish { proxy_pass $gateway/sessions/ingest/publish?secret=@HOOK_SECRET@; }
        location = /done    { proxy_pass $gateway/sessions/ingest/done?secret=@HOOK_SECRET@; }
        location /          { return 404; }
    }

    # What Caddy proxies /hls* to. Read-only, no directory listing.
    server {
        listen 8080;
        location /hls/ {
            alias /var/hls/;
            limit_except GET HEAD { deny all; }
            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }
            # A playlist changes every few seconds: nothing may cache it. A segment never changes.
            location ~ \.m3u8$ { add_header Cache-Control "no-cache"; }
            location ~ \.ts$   { add_header Cache-Control "max-age=60"; }
        }
        location = /healthz { return 200 "ok\n"; }
        location /          { return 404; }
    }
}
